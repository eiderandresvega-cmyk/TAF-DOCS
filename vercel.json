{"$schema":"https://openapi.vercel.sh/vercel.json","framework":"vite","installCommand":"npm ci","buildCommand":"mkdir -p dist && printf '%s' '<!doctype html><html lang=es><head><meta charset=utf-8><meta name=viewport content=width=device-width,initial-scale=1><meta name=robots content=noindex,nofollow><title>Próximamente | TAF</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f6f7f9;color:#202124;font:16px system-ui,sans-serif}main{text-align:center;padding:3rem}h1{font-size:clamp(2.5rem,8vw,5rem);margin:0 0 1rem}p{color:#5f6368;font-size:1.1rem}</style></head><body><main><h1>Próximamente</h1><p>Estamos preparando una nueva versión del sitio.</p></main></body></html>' > dist/index.html","outputDirectory":"dist","rewrites":[{"source":"/(.*)","destination":"/index.html"}],"headers":[{"source":"/(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"Cache-Control","value":"no-store, max-age=0"},{"key":"Content-Security-Policy","value":"default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"}]}]}
