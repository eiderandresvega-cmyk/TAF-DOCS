{
  "name": "taf-docs",
  "version": "0.1.0",
  "description": "Documentación local de pruebas QA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/pwa.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'e2e/**'",
    "test:e2e": "playwright test",
    "test:performance": "node scripts/performance.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiderandresvega-cmyk/TAF-DOCS.git"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
}
